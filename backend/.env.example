# Backend Environment Configuration
# Used by Vercel Project 2 (Backend Instance)
# NEVER expose these variables in frontend or client-side bundles.

# Hunar.AI Voice API Configuration
HUNAR_API_KEY=your_hunar_api_key_here
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# Database Configuration
# Local dev: sqlite:///./hiring_assistant.db
# Vercel / Production: Use Cloud PostgreSQL (Neon / Supabase / Vercel Postgres)
# e.g.: postgresql+pg8000://username:password@ep-host.region.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./hiring_assistant.db

# CORS Configuration (Set to your deployed frontend domain in production)
# Example for production: https://your-frontend-project.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Webhook Base URL (Public URL where your backend receives webhooks from Hunar AI)
# Example: https://your-backend-project.vercel.app
WEBHOOK_BASE_URL=

# Optional Sourcing / People Search API Keys
PDL_API_KEY=
APOLLO_API_KEY=
PROXYCURL_API_KEY=
CORESIGNAL_API_KEY=
