# Backend Environment Configuration
# Used by Vercel Project (Backend Instance)
# NEVER expose these variables in frontend or client-side bundles.

# Hunar.AI Voice API Configuration
HUNAR_API_KEY=your_hunar_api_key_here
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1

# Database Configuration (Neon PostgreSQL for persistent cloud storage)
# Format: postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-bread-a5vyy005-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration (Set to your deployed frontend domain in production)
# Example: https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Webhook Base URL (Public URL where your backend receives webhooks from Hunar AI)
# Example: https://your-backend.vercel.app
WEBHOOK_BASE_URL=https://your-backend.vercel.app

# Optional Sourcing / People Search API Keys
PDL_API_KEY=
APOLLO_API_KEY=
PROXYCURL_API_KEY=
CORESIGNAL_API_KEY=

